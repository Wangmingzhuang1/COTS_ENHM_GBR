iigD/9k=</Data></Thumbnail></Binary><mdLang><languageCode value="eng"/><countryCode value="AUS" Sync="TRUE"/></mdLang><mdChar><CharSetCd value="004"/></mdChar><mdHrLv><ScopeCd value="005"/></mdHrLv><mdHrLvName>dataset</mdHrLvName><mdContact><rpOrgName>Great Barrier Reef Marine Park Authority</rpOrgName><rpPosName>Director - Science for Management</rpPosName><rpCntInfo><cntPhone><voiceNum>+ 61 7 4750 0700</voiceNum></cntPhone><cntAddress><delPoint>PO Box 1379</delPoint><city>Townsville</city><adminArea>Queensland</adminArea><postCode>4810</postCode><country>AU</country><eMailAdd>Science@gbrmpa.gov.au</eMailAdd></cntAddress></rpCntInfo><role><RoleCd value="003"/></role></mdContact><mdDateSt Sync="TRUE">20260211</mdDateSt><mdStanName>ArcGIS Metadata</mdStanName><mdStanVer>1.0</mdStanVer><dataIdInfo><idCitation><resTitle>Terrestrial and Marine NRM Regions of the Great Barrier Reef </resTitle><date><pubDate>2007-07-16</pubDate><reviseDate>2011-04-06</reviseDate></date><resEd>v1.0</resEd><resEdDate>20110406</resEdDate><citRespParty><rpOrgName>Great Barrier Reef Marine Park Authority</rpOrgName><rpPosName>Director - Science for Management</rpPosName><rpCntInfo><cntPhone><voiceNum>+ 61 7 4750 0700</voiceNum></cntPhone><cntAddress><delPoint>PO Box 1379</delPoint><city>Townsville</city><adminArea>Queensland</adminArea><postCode>4810</postCode><country>AU</country><eMailAdd>Science@gbrmpa.gov.au</eMailAdd></cntAddress></rpCntInfo><role><RoleCd value="003"/></role></citRespParty><presForm><PresFormCd value="005" Sync="TRUE"/></presForm></idCitation><idAbs>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;A dataset displaying the location and spatial extent of the six terrestrial and marine Natural Resource Management (NRM) regions located adjacent to and within the Great Barrier Reef World Heritage Area (GBRWHA), which is located off the coast of Queensland, Australia. The terrestrial NRM regions are based on the Commonwealth Government’s “Natural Resource Management Regions 2023” dataset. The NRM regional boundaries were sourced from the Commonwealth Dept of Climate Change, Energy, the Environment &amp;amp;amp; Water (DCCEEW) and clipped to the Great Barrier Reef Catchment. The marine NRM regions are an extension of the terrestrial NRM regions out to the boundary of the Great Barrier Reef World Heritage Area for illustrative purposes.The dataset was created by the Great Barrier Reef Marine Park Authority (GBRMPA) on the 24 Oct 2025 and is intended to allow users to visualise the spatial extent and boundaries of each of the six terrestrial and marine NRM regions adjacent to and within the Great Barrier Reef World Heritage Area.Clipping the data to the boundary of the Great Barrier Reef World Heritage Area produces the closely-related “NRM_Marine_Regions_GBR” dataset.  NOTE: The dataset was created for display purposes only and is NOT an authoritative source of the NRM boundaries. This dataset does NOT demarcate legislated or administrative boundaries. This dataset does NOT demarcate environmental or management zones.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;&lt;/DIV&gt;</idAbs><idPurp>The dataset depicts the location and spatial extent of the terrestrial and marine Natural Resource Management regions adjacent to and located within the Great Barrier Reef World Heritage Area for reporting of annual Great Barrier Reef Marine Monitoring Program results and for illustrative purposes.</idPurp><idCredit>© Great Barrier Reef Marine Park Authority 2025</idCredit><idPoC><rpOrgName>Great Barrier Reef Marine Park Authority</rpOrgName><rpPosName>Director - Science for Management</rpPosName><rpCntInfo><cntPhone><voiceNum>+ 61 7 4750 0700</voiceNum></cntPhone><cntAddress><delPoint>PO Box 1379</delPoint><city>Townsville</city><adminArea>Queensland</adminArea><postCode>4810</postCode><country>AU</country><eMailAdd>Science@gbrmpa.gov.au</eMailAdd></cntAddress></rpCntInfo><role><RoleCd value="003"/></role></idPoC><resMaint>